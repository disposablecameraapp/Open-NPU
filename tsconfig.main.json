{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src/core/**/*.ts", "src/core/**/*.tsx", "src/main/**/*.ts", "src/shared/**/*.ts", "src/voice/**/*.ts"]
}
